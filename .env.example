# VarshaRakshak Environment Configuration Template
# DO NOT COMMIT ACTUAL API KEYS OR PRIVATE KEYS HERE.
# Copy this file to .env and fill in your confidential credentials locally.

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Supabase Backend & PostgreSQL Authentication
# Set your genuine project URL and anon public key from Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Ethereum Sepolia Blockchain
# Public keyless RPC URLs: https://rpc.sepolia.org, https://eth-sepolia.public.blastapi.io, https://1rpc.io/sepolia
SEPOLIA_RPC_URL=https://rpc.sepolia.org
ALCHEMY_API_KEY=your_alchemy_api_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here
SEPOLIA_PRIVATE_KEY=your_testnet_private_key_here_for_deployment_only
CHAIN_ID=11155111

# Deployed Contract Addresses on Sepolia (populated after running deployment script)
POLICY_REGISTRY_ADDRESS=
TRIGGER_REGISTRY_ADDRESS=
CLAIM_MANAGER_ADDRESS=
PAYOUT_AUTHORIZER_ADDRESS=

# Weather APIs
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_PROVIDER=openmeteo
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Speech & Localization
DEFAULT_LANGUAGE=hi

# Feature Flags
ENABLE_WEATHER_SIMULATOR=true
ENABLE_DEMO_DATA_LABELS=true
ENABLE_AUTO_PAYOUT_DISPATCH=true
